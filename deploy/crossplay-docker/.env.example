# Copy to .env and fill in. Never commit .env: it holds the EOS client secret.

# ---- EOS credentials of the DST mobile deployment ----------------------------
DST_EOS_PRODUCT_ID=
DST_EOS_SANDBOX_ID=
DST_EOS_DEPLOYMENT_ID=
DST_EOS_CLIENT_ID=
DST_EOS_CLIENT_SECRET=

# ---- What players see ---------------------------------------------------------
# Put a value in double quotes if it contains ' #': Compose reads that as a comment.
SERVER_NAME=DST Crossplay
# Join password. The row is always listed as password protected; do not leave this empty.
SERVER_PASSWORD=change-me
# \n is a line break in the details panel.
SERVER_DESCRIPTION=Crossplay Mobile x PC
MAX_PLAYERS=6
# Extra tags on the Mobile row, comma separated (english and the game mode are always there).
SERVER_TAGS=
# survival resets the world when every player is dead; endless does not.
GAME_MODE=survival
# Klei lobby region that lists the row: us-east-1, eu-central-1, ap-southeast-1, ap-east-1.
REGION=ap-southeast-1

# ---- Which parts run on this machine -----------------------------------------
# server    = the game server (surface).  Remove it to front a server that runs elsewhere
#             (then set BRIDGE_SERVER to its host:port).
# caves     = the Caves shard and its bridge. Remove it for a surface-only world.
# announcer = the Mobile lobby row.       Remove it if another machine announces for you.
COMPOSE_PROFILES=server,caves,announcer

# ---- Online or offline ----------------------------------------------------------
# Tokens are files, not .env values (see README "Tokens"):
#   vendor/cluster_token.txt        Mobile row (announcer)
#   vendor/cluster_token_steam.txt  Steam row (the server lists itself)
# auto = online when vendor/cluster_token_steam.txt exists, offline LAN demo otherwise.
OFFLINE_CLUSTER=auto

# ---- Ports (UDP). An offline cluster must stay inside 10998-11018. -------------
# Forward all four to this machine: PC players use SERVER_PORT and CAVES_PORT.
SERVER_PORT=11011
BRIDGE_PORT=11012
CAVES_PORT=11013
CAVES_BRIDGE_PORT=11014
# Public IP of this machine. Phones from the Mobile Online list change shard over EOS
# (relay-caves); this address is only the label of that connection and of a LAN-joined
# phone's direct UDP move to CAVES_BRIDGE_PORT.
PUBLIC_HOST=
# Id of the Caves shard in the Mobile row's secondaries (the Master is 1). Any number but 1.
CAVES_SHARD_ID=2
BRIDGE_SERVER=127.0.0.1:11011

# ---- Rarely changed ------------------------------------------------------------
# A second stack on the same machine needs its own project name and ports:
# COMPOSE_PROJECT_NAME=dst-crossplay-2
CLUSTER_NAME=Crossplay
DST_SERVER_DIR=./vendor/dst-server
BRIDGE_LOG=/dev/null
CAVES_BRIDGE_LOG=/dev/null
# Shard link (loopback) and Steam query ports (no forwarding needed); change them when
# two stacks share one machine.
SHARD_PORT=10888
MASTER_STEAM_PORT=27016
MASTER_AUTH_PORT=8766
CAVES_STEAM_PORT=27017
CAVES_AUTH_PORT=8767
# AllowRelays works against any phone setting; the others are for NAT debugging.
DST_EOS_RELAY_CONTROL=AllowRelays
